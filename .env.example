# Copy these into Hostinger → Node.js → Environment variables
# Do NOT commit real secrets to GitHub.

NODE_ENV=production
# Hostinger usually sets PORT automatically — do not hardcode if the panel provides it
# PORT=3000

DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME?connection_limit=5
USER_FRONTEND_URL=https://halodirect.io
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=60m
JWT_ACCESS_EXPIRES_IN=1d

# Google Workspace SMTP relay (IP allowlist — no username/password)
# Only works from Hostinger IP 194.11.154.67. Local/dev sends will be rejected.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
MAIL_FROM=info@halodirect.io
ADMIN_EMAIL=info@halodirect.io
# Optional: pin outbound IPv4 so Google sees the allowlisted address
# SMTP_LOCAL_ADDRESS=194.11.154.67
# Leave these empty on Hostinger. Google trusts the server IP.
# SMTP_USER=
# SMTP_PASS=
